[
  {
    "label": "App: Rust backend",
    "adapter": "CodeLLDB",
    "request": "launch"
  },
  {
    "label": "App: frontend (attach to the web view)",
    "adapter": "JavaScript",
    "type": "pwa-msedge",
    "request": "attach",
    "useWebView": true,
    "port": 9222,
    "webRoot": "src/frontend",
    "sourceMaps": true
  },
  {
    "label": "App: frontend (fallback: pwa-chrome)",
    "adapter": "JavaScript",
    "type": "pwa-chrome",
    "request": "attach",
    "port": 9222,
    "webRoot": "src/frontend",
    "sourceMaps": true
  },
  {
    "label": "Frontend in Chrome",
    "adapter": "JavaScript",
    "type": "pwa-chrome",
    "request": "launch",
    "url": "http://localhost:1420"
  }
]
